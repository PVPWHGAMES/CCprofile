{
  "enabledPlugins": {
    "aegis@aegis-dev": true,
    "code-simplifier@claude-plugins-official": true,
    "ecc@ecc": true,
    "planning-with-files@planning-with-files": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "self-improving-agent@claude-code-skills": true,
    "supergoal@supergoal": true,
    "waza@waza": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "PROXY_MANAGED",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:15721",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "deepseek-v4.1-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "deepseek-v4.1-flash",
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "aegis-dev": {
      "source": {
        "repo": "GanyuanRan/Aegis",
        "source": "github"
      }
    },
    "claude-code-skills": {
      "source": {
        "repo": "alirezarezvani/claude-skills",
        "source": "github"
      }
    },
    "ecc": {
      "source": {
        "repo": "affaan-m/ECC",
        "source": "github"
      }
    },
    "planning-with-files": {
      "source": {
        "repo": "OthmanAdi/planning-with-files",
        "source": "github"
      }
    },
    "supergoal": {
      "source": {
        "repo": "robzilla1738/supergoal",
        "source": "github"
      }
    },
    "waza": {
      "source": {
        "repo": "tw93/Waza",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "(cd ~/.claude && git add settings.json && (git diff --cached --quiet || git commit -m \"chore: update API config\" --quiet)) 2>/dev/null || true; git -C ~/.claude pull --no-rebase --autostash --quiet 2>/dev/null || (cd ~/.claude && git checkout --ours . && git add -A && git commit -m \"sync: auto-resolve\" --quiet) 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}