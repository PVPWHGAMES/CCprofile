{
  "enabledPlugins": {
    "aegis@aegis-dev": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "PROXY_MANAGED",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:15721",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5[1M]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "gpt-6-sol",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "gpt-6-sol",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5[1M]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "gpt-6-sol",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1M]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "gpt-6-sol",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gpt-6-sol",
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "aegis-dev": {
      "source": {
        "path": "C:\\Users\\pvp\\.claude\\plugins\\marketplaces\\GanyuanRan-Aegis",
        "source": "directory"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "(cd ~/.claude && git add settings.json && (git diff --cached --quiet || git commit -m \"chore: update API config\" --quiet)) 2>/dev/null || true; git -C ~/.claude pull --no-rebase --autostash --quiet 2>/dev/null || (cd ~/.claude && git checkout --ours . && git add -A && git commit -m \"sync: auto-resolve\" --quiet) 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}